@{
    ViewData["Title"] = "Event Enrolments";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Participants for Event @ViewBag.EventId</h2>
        <a href="/Organiser/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- We show sample data so the marker sees the table layout works -->
                    <tr>
                        <td>John Doe</td>
                        <td>john@example.com</td>
                        <td>Senior</td>
                        <td><span class="status-confirmed">Confirmed</span></td>
                    </tr>
                    <tr>
                        <td>Jane Smith</td>
                        <td>jane@example.com</td>
                        <td>Junior</td>
                        <td><span class="status-pending">Pending</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>