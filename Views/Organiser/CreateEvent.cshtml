@model RaceDayMVC.Models.EventModel

@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit ? "Edit Event" : "Create Event";
}

<div class="container mt-5" style="min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">

                <div class="card-header @(isEdit ? "bg-warning text-dark" : "bg-primary text-white")">
                    <h4 class="mb-0">
                        @(isEdit ? "Edit Event" : "Create a New Event")
                    </h4>
                </div>

                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="CreateEvent" method="post">

                        <input type="hidden" asp-for="EventId" />

                        <input type="hidden" name="isEdit"
                               value="@(isEdit.ToString().ToLower())" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EventName">Event Name</label>
                                <input asp-for="EventName"
                                       class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EventType">Event Type</label>
                                <input asp-for="EventType"
                                       class="form-control"
                                       placeholder="e.g. Marathon"
                                       required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EventDate">Date</label>
                                <input asp-for="EventDate"
                                       type="date"
                                       class="form-control"
                                       value="@(Model.EventDate == DateTime.MinValue ? "" : Model.EventDate.ToString("yyyy-MM-dd"))"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Distance">Distance</label>
                                <input asp-for="Distance"
                                       class="form-control"
                                       placeholder="e.g. 5km, 10km, 21km"
                                       required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location">Location</label>
                            <input asp-for="Location"
                                   class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDescription">Description</label>
                            <textarea asp-for="EventDescription"
                                      class="form-control"
                                      rows="3" required></textarea>
                        </div>

                        <button type="submit"
                                class="btn @(isEdit ? "btn-warning" : "btn-primary") w-100">
                            @(isEdit ? "Save Changes" : "Create Event")
                        </button>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
