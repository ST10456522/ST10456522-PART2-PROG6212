@{
    ViewData["Title"] = "RaceDay";
}

<div class="text-center mt-5">
    <h1>Welcome to RaceDay</h1>

    <p class="lead">
        Your race. Your journey. Your achievement.
    </p>

    <p>
        Discover upcoming races, register for events
        and keep track of your race results.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-primary">
        Login
    </a>

    <a asp-controller="Account"
       asp-action="Register"
       class="btn btn-outline-primary">
        Register
    </a>
</div>
