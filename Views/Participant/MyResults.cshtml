@{
    ViewData["Title"] = "My Results";
}
<div class="container mt-4">
    <h2>My Race History</h2>
    <p class="text-muted">Results are captured by the Organiser after the event concludes.</p>

    <div class="card shadow mt-3">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center py-4">You have not completed any events yet.</td>
                    </tr>
                    <!-- Example of what it would look like if data was returned:
                    <tr>
                        <td>Jozi Express</td>
                        <td>30 Dec 2026</td>
                        <td>Senior</td>
                        <td>02:15:30</td>
                        <td>47th out of 312</td>
                    </tr>
                    -->
                </tbody>
            </table>
        </div>
    </div>
</div>