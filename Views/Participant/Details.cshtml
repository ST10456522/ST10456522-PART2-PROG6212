@model RaceDayMVC.Models.EventModel
@{
    ViewData["Title"] = Model.EventName;
    var categories = ViewBag.Categories as List<RaceDayMVC.Models.CategoryModel>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h2 class="mb-0">@Model.EventName</h2>
                </div>
                <div class="card-body">
                    <h5 class="text-primary">@Model.EventType</h5>
                    <p class="lead">@Model.EventDescription</p>

                    <div class="row mb-4">
                        <div class="col-md-4"><strong>📅 Date:</strong><br />@Model.EventDate.ToString("dd MMM yyyy")</div>
                        <div class="col-md-4"><strong>📍 Location:</strong><br />@Model.Location</div>
                        <div class="col-md-4"><strong>🏃 Distance:</strong><br />@Model.Distance</div>
                    </div>

                    <hr />

                    <h5>Register for this Event</h5>
                    <form asp-action="Enrol" method="post" class="mt-3">
                        <input type="hidden" name="eventId" value="@Model.EventId" />

                        <div class="mb-3">
                            <label class="form-label">Select Your Category</label>
                            <select name="categoryId" class="form-select" required>
                                <option value="">-- Choose Category --</option>
                                @if (categories != null)
                                {
                                    foreach (var cat in categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Confirm Enrolment</button>
                        <a href="/Participant/Index" class="btn btn-secondary w-100 mt-2">Back to Events</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>